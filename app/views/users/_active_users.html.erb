<% page_header do %>
	<div class="pull-right">
		<%= link_to "Add New Regular User", new_user_path, class: "btn btn-success" %>
	</div>
	<h1>Active User List</h1>
<% end %>

<p><%= link_to "Inactive Users", users_path(inactive: true), class: "pull-right" %></p>
<br/>

<hr>
<form action="<%= users_path %>" xdata-bs-remote="true" id="user-search-form" method="get">
    <div class="input-group">
        <span class="input-group-text">
            <i class="fa fa-search"></i>
        </span>
        
        <input type="text" 
               class="form-control search_auto_submitx"  
               autocomplete="off" placeholder="Type user's name and press enter to search" 
               name="term" value="<%= @query if @query %>" 
               title="search field">
    </div>

    <input type="hidden" name="type" value="users"/>
    <input type="submit" value="search" class="d-none"> 
</form>
<hr>

<hr/>
<h3 class='text-center'>Most recent 100 Instructors</h3>

<div class="card">
    <div class="card-header bg-info">
        <h3 class="mb-0">Instructors</h3>
    </div>

    <div class="table-responsive"> 
        <table class="table table-bordered mb-0">
            <thead>
                <tr class="table-light"> 
                    <th scope="col">User Type</th>
                    <th scope="col">Department</th>
                    <th scope="col">Office</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Email</th>
                    <th scope="col" style="width: 10%;"></th>
                </tr>
            </thead>
            <tbody id="users">
                <% for user in @users %>
                    <%= render user %>
                <% end %>
            </tbody>
        </table>
    </div>
</div>