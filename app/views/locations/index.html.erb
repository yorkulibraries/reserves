<% title "Library Locations" %>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead class="table-info">
      <tr>
        <th class="bg-info">Name</th>
        <th class="bg-info">Contact Email</th>
        <th class="bg-info">Contact Phone</th>
        <th class="bg-info">Address</th>
        <th class="bg-info">Notify About New Items?</th>
        <th class="bg-info">Allowed <br/> Item Types</th>
        <th class="bg-info">Disallowed <br/> Item Types</th>
        <th class="bg-info"></th>
      </tr>
    </thead>

    <tbody>
      <% @locations.each do |location| %>
        <tr>
          <td><%= location.name %><br/>
            <span class="small text-muted"><%= location.ils_location_name %></span>
          </td>
          <td><%= location.contact_email %></td>
          <td><%= location.contact_phone %></td>
          <td><%= location.address %></td>
          <td><%= location.setting_bcc_location_on_new_item? ? "Yes" : "No" %></td>
          <td><%= raw Item::TYPES.reject { |t| location.disallowed_item_types.include?(t) }.join("<br/> ") %></td>
          <td><%= raw location.disallowed_item_types.join("<br/> ") %></td>
          <td><%= link_to 'Make Changes', edit_location_path(location), class: "btn btn-success btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<br>

<%= link_to '<i class="fa fa-plus"></i> Add a new location'.html_safe, new_location_path, class: "btn btn-primary" %>
