<% title "Reports: Dashboard" %>

<div class="container py-4">
  <% default_interval = Setting.reports_default_interval.to_i %>
  <% interval_name = distance_of_time_in_words(default_interval) %>
  <% interval_past = Time.current - default_interval %>
  <% interval_future = Time.current + default_interval %>

  <div class="row g-4">
    <div class="col-12 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5 fw-semibold mb-3 text-success">Request Reports</h2>
          <hr />
          <ul class="list-group list-group-flush">
            <li class="list-group-item px-0">
              <%= link_to "Expiring Requests in #{interval_name}", requests_reports_path(r: { expiring_before: interval_future.to_date } ), class: "text-decoration-none" %>
            </li>
            <li class="list-group-item px-0">
              <p class="fw-semibold mb-2">Requests Per Location, Last <%= interval_name %></p>
              <ol class="list-group list-group-numbered list-group-flush small mb-0">
                <% Location.active.each do |location| %>
                  <li class="list-group-item border-0 ps-0">
                    <%= link_to location.name, requests_reports_path(r: { location: location.id, created_after: interval_past.to_date }), class: "text-decoration-none" %>
                  </li>
                <% end %>
              </ol>
            </li>
            <li class="list-group-item px-0">
              <%= link_to "Custom Report", requests_reports_path(r: { created_after: interval_past.to_date} ), class: "text-decoration-none" %>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5 fw-semibold mb-3 text-warning">Item Reports</h2>
          <hr />
          <ul class="list-group list-group-flush">
            <li class="list-group-item px-0">
              <%= link_to "Items Created in the last #{interval_name}", items_reports_path(r: { created_after: interval_past.to_date} ), class: "text-decoration-none" %>
            </li>
            <li class="list-group-item px-0">
              <p class="fw-semibold mb-2">Items Per Location, Last <%= interval_name %></p>
              <ol class="list-group list-group-numbered list-group-flush small mb-0">
                <% Location.active.each do |location| %>
                  <li class="list-group-item border-0 ps-0">
                    <%= link_to location.name, items_reports_path(r: { location: location.id, created_after: interval_past.to_date }), class: "text-decoration-none" %>
                  </li>
                <% end %>
              </ol>
            </li>
            <li class="list-group-item px-0">
              <p class="fw-semibold mb-2">Items By Type, Last <%= interval_name %></p>
              <ol class="list-group list-group-numbered list-group-flush small mb-0">
                <% Item::TYPES.each do |type| %>
                  <li class="list-group-item border-0 ps-0">
                    <%= link_to type, items_reports_path(r: { item_types: type, created_after: interval_past.to_date }), class: "text-decoration-none" %>
                  </li>
                <% end %>
              </ol>
            </li>
            <li class="list-group-item px-0">
              <%= link_to "Custom Report", items_reports_path(r: { created_after: interval_past.to_date} ), class: "text-decoration-none" %>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5 fw-semibold mb-3 text-danger">Statistics</h2>
          <hr />
          <ul class="list-group list-group-flush">
            <li class="list-group-item px-0 pb-0">
              <p class="text-uppercase text-muted small mb-1">Fiscal</p>
              <p class="fw-semibold mb-0"><%= Setting.fiscal_date.strftime("%b %e, %Y") %> to Today</p>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Requests</span>
              <span class="badge rounded-pill text-bg-primary"><%= number_with_delimiter(@ytd_requests_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Items</span>
              <span class="badge rounded-pill text-bg-success"><%= number_with_delimiter(@ytd_items_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Courses</span>
              <span class="badge rounded-pill text-bg-info"><%= number_with_delimiter(@ytd_courses_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Requestors</span>
              <span class="badge rounded-pill text-bg-warning text-dark"><%= number_with_delimiter(@ytd_requestors_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Staff</span>
              <span class="badge rounded-pill text-bg-secondary"><%= number_with_delimiter(@ytd_staff_count) %></span>
            </li>
            <li class="list-group-item px-0 pt-3 pb-0 border-top">
              <p class="text-uppercase text-muted small mb-1">Lifetime</p>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Requests</span>
              <span class="badge rounded-pill text-bg-primary"><%= number_with_delimiter(@lt_requests_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Items</span>
              <span class="badge rounded-pill text-bg-success"><%= number_with_delimiter(@lt_items_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Courses</span>
              <span class="badge rounded-pill text-bg-info"><%= number_with_delimiter(@lt_courses_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Requestors</span>
              <span class="badge rounded-pill text-bg-warning text-dark"><%= number_with_delimiter(@lt_requestors_count) %></span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted">Staff</span>
              <span class="badge rounded-pill text-bg-secondary"><%= number_with_delimiter(@lt_staff_count) %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
