<% title "Reports: Items" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Filters</h2>
    <%= link_to "Reports Home", reports_path, class: "btn btn-outline-primary btn-sm" %>
  </div>

  <%= form_for :r, url: items_reports_path, html: { class: "row g-3 align-items-end mb-4 bg-light p-4", method: :get } do |f| %>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Item Types", class: "form-label" %>
      <%= f.select "item_types", Item::TYPES, { include_blank: "All", selected: @item_types }, class: "form-select" %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Location", class: "form-label" %>
      <%= f.select "location", Location.active.collect { |location| [location.name, location.id] }, { include_blank: "All", selected: @location }, class: "form-select" %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Faculty", class: "form-label" %>
      <%= f.select "faculty", Course::FACULTIES, { include_blank: "All", selected: @faculty }, class: "form-select" %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Department", class: "form-label" %>
      <%= f.select "department", Course::SUBJECTS, { include_blank: "All", selected: @department }, class: "form-select" %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Term", class: "form-label" %>
      <%= f.select "term", Course::TERMS, { include_blank: "All", selected: @term }, class: "form-select" %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Created After", class: "form-label" %>
      <%= f.text_field "created_after", class: "form-control datepicker", value: @created_after %>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <%= f.label "Created Before", class: "form-label" %>
      <%= f.text_field "created_before", class: "form-control datepicker", value: @created_before %>
    </div>
    <div class="col-12 col-md-6 col-xl-3"></div>
    <div class="col-12 col-md-6 col-xl-3">
      <div>
        <%= f.submit "Generate", class: "btn btn-primary w-100", data: { disable_with: "Processing" } %>
      </div>
    </div>
  <% end %>

  <div class="collapse mb-4" id="to_sql">
    <div class="card card-body text-bg-light">
      <p class="mb-1"><%= @courses.to_sql if @courses %></p>
      <p class="mb-1"><%= @requests.to_sql if @requests %></p>
      <p class="mb-0"><%= @items.to_sql if @items %></p>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-3">
        <h2 class="h5 mb-2 mb-md-0">Total Found: <%= @items.size %></h2>
        <div class="btn-group">
          <a href="<%= items_reports_path(params: request.query_parameters, format: "xlsx") %>" class="btn btn-outline-success btn-sm">
            <span class="fa fa-download me-1"></span> Excel
          </a>
          <button class="btn btn-outline-warning btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#to_sql" aria-expanded="false" aria-controls="to_sql">
            <span class="fa fa-database me-1"></span> SQL
          </button>
        </div>
      </div>

      <ul class="list-group list-group-flush">
        <% @items_grouped.each do |type, items| %>
          <li class="list-group-item list-group-item-info d-flex justify-content-between align-items-center">
            <span><%= type.presence || "Unknown" %></span>
            <span class="badge rounded-pill text-bg-primary"><%= pluralize(items.size, "item") %></span>
          </li>

          <% items.each do |item| %>
            <li class="list-group-item py-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <% request_link = item.request ? link_to(item.request.id, item.request, class: "link-primary fw-semibold") : content_tag(:span, "No Request", class: "text-muted") %>
                <span class="badge text-bg-<%= item.status == Item::STATUS_READY ? "success" : "secondary" %> status-<%= item.status.parameterize %>">
                  <%= item.status.humanize.upcase %>
                </span>
              </div>
              <div class="row g-2">
                <div class="col-12 col-md-3">
                  <span class="text-muted d-block small text-uppercase">Request</span>
                  <%= request_link %>
                </div>
                <div class="col-12 col-md-3">
                  <span class="text-muted d-block small text-uppercase">Title</span>
                  <span class="fw-semibold"><%= item.title %></span>
                </div>
                <div class="col-12 col-md-3">
                  <span class="text-muted d-block small text-uppercase">Course</span>
                  <% course = item.request&.course %>
                  <% if course %>
                    <%= [course.year, course.faculty, course.subject, course.term].compact.join(" · ") %>
                  <% else %>
                    <span class="text-muted">N/A</span>
                  <% end %>
                </div>
                <div class="col-12 col-md-3">
                  <span class="text-muted d-block small text-uppercase">Source</span>
                  From <%= item.metadata_source.presence || "Unknown" %>
                </div>
              </div>
            </li>
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>
</div>
