(() => {
    bootstrap_modal_show("item_form", "<%= j(render 'form_modal') %>");

    const modalEl = document.getElementById('item_form');
    if (!modalEl) return;

    if (typeof window.setupItemModal === 'function') {
        window.setupItemModal(modalEl, { runInitializer: true });
    } else {
        const initName = (modalEl.dataset.initializer || "").trim();
        if (initName && typeof window[initName] === 'function') {
            try { window[initName](); } catch (e) { console.error(`[items/new.js] initializer ${initName} threw`, e); }
        }
        if (typeof searchRecords === 'function') searchRecords();
    }

})();
