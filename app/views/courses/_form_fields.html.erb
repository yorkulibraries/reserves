
<div class="course_fields mb-3">
	<!-- Course Title Row -->
	<div class="row mb-3">
		<div class="col-md-8">
			<!-- <%= f.input :name, label: "Course Title" %> -->
			<div class="has-error"><span class="help-block has-error">
				<%= f.object.errors[:code].join(",") %>
			</span></div>
		</div>
	</div>
	<div class="row">
	</div>

	<div class="row">
		<div class="col-md-12 col-lg-12">
			<%= hidden_field_tag 'request[course_info_id]', nil, id: 'request_course_info_id_hidden' %>
			<%= text_field_tag nil, nil,
				id: 'request_course_search',
				placeholder: 'Search for a course',
				autocomplete: 'off',
				class: 'form-control' %>


			<%= hidden_field_tag 'request[alma_instructor_id]', '', id: 'request_alma_instructor_id' %>
		</div>

	</div>
	<div class="row">
		<div class="col-md-3"><%= f.input :student_count, label: "Enrollment", input_html: { min: 0 } %></div>
	</div>
</div>
