<div class="container py-4">
  <% title "All Active Courses" %>

  <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center mb-4">
    <h1 class="h3 mb-0">All Active Courses</h1>
    <%= link_to "View Active Courses", courses_active_index_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="bg-info">Name</th>
              <th scope="col" class="bg-info">Code</th>
              <th scope="col" class="text-center bg-info">Students</th>
              <th scope="col" class="bg-info">Instructor</th>
              <th scope="col" class="text-end bg-info">Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if @courses.any? %>
              <% @courses.each do |course| %>
                <tr>
                  <td class="fw-semibold"><%= course.name %></td>
                  <td><span class="badge bg-secondary text-uppercase"><%= course.code %></span></td>
                  <td class="text-center"><%= course.student_count %></td>
                  <td><%= course.instructor.presence || content_tag(:span, "TBD", class: "text-muted") %></td>
                  <td class="text-end">
                    <%= link_to "Make Changes", edit_course_path(course), class: "btn btn-sm btn-primary" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" class="text-center text-muted py-4">
                  No courses found.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @courses %>
  </div>
</div>
