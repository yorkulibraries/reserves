<div class="modal fade" id="help_assistance_modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title mb-0">Help/Assistance</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <h4><%= Setting.help_title %></h4>
        <%= simple_format Setting.help_body %>
        <hr/>
        <p> <a href="<%= Setting.help_link %>" target="_blank"><span class="fa fa-question"></span> Get More Help</a></p>
        <%= simple_format Setting.help_contact %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>

    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
