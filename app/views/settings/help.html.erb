<% title "Update Help Settings" %>
<div class="container py-2">
  <div class="row">
    <div class="col-lg-9 col-xl-8">
      <%= simple_form_for Setting.new, url: settings_path, method: :patch, html: { class: "card shadow-sm border-0 mb-4" } do |f| %>
        <div class="card-header bg-white border-0 pb-0">
          <p class="text-muted mb-0">Customize the help panel students and staff see inside the application.</p>
        </div>
        <div class="card-body">
        <section class="mb-4 bg-light p-3">
          <div class="row g-3">
            <%= f.input :help_title,
                        wrapper_html: { class: "col-12 col-md-6" },
                        label_html: { class: "form-label" },
                        input_html: { class: "form-control" } %>
            <%= f.input :help_link,
                        label: "More Help Link",
                        wrapper_html: { class: "col-12 col-md-6" },
                        label_html: { class: "form-label" },
                        input_html: { class: "form-control" } %>
            <%= f.input :help_body,
                        as: :text,
                        label: "Brief Help Text",
                        wrapper_html: { class: "col-12" },
                        label_html: { class: "form-label" },
                        input_html: { class: "form-control", rows: 8 } %>
            <%= f.input :help_contact,
                        as: :text,
                        label: "Help Contact Details",
                        wrapper_html: { class: "col-12" },
                        label_html: { class: "form-label" },
                        input_html: { class: "form-control", rows: 4 } %>
            </div>
          </div>
        </div>
        <div class="card-footer bg-white border-0 pt-0 d-flex justify-content-between align-items-center">
          <input type="hidden" name="return_to" value="help"/>
          <%= f.submit "Save Help Settings", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>