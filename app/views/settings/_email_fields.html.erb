<ul class="nav nav-tabs" id="emailSettingsTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link active" id="general-email-tab" data-bs-toggle="tab" href="#general_email_settings" role="tab" aria-controls="general_email_settings" aria-selected="true">
      General
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="welcome-email-tab" data-bs-toggle="tab" href="#welcome_email_settings" role="tab" aria-controls="welcome_email_settings" aria-selected="false">
      Welcome Email
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="status-email-tab" data-bs-toggle="tab" href="#status_change_email_settings" role="tab" aria-controls="status_change_email_settings" aria-selected="false">
      Status Change Email
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="expiry-email-tab" data-bs-toggle="tab" href="#expiry_notice_email_settings" role="tab" aria-controls="expiry_notice_email_settings" aria-selected="false">
      Expiry Notice Email
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="helpful-tags-tab" data-bs-toggle="tab" href="#helpful_tags_settings" role="tab" aria-controls="helpful_tags_settings" aria-selected="false">
      Helpful Tags
    </a>
  </li>
</ul>

<div class="tab-content pt-3 px-2" id="emailSettingsTabContent">
  <div class="tab-pane fade show active" id="general_email_settings" role="tabpanel" aria-labelledby="general-email-tab">
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.input :email_allow,
                    as: :radio_buttons,
                    label: "Enable Email Communication?",
                    label_html: { class: "form-label d-block fw-semibold" },
                    collection_wrapper_tag: :div,
                    collection_wrapper_class: "d-flex gap-3 flex-wrap",
                    item_wrapper_class: "form-check",
                    item_label_class: "form-check-label",
                    input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-12 col-lg-6">
        <%= f.input :email_from,
                    label: "From Address",
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control" } %>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="welcome_email_settings" role="tabpanel" aria-labelledby="welcome-email-tab">
    <h4 class="h5 mb-3">Welcome Email</h4>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.input :email_welcome_subject,
                    label: "Subject",
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control" } %>
      </div>
      <div class="col-12">
        <%= f.input :email_welcome_body,
                    as: :text,
                    label: "Body",
                    wrapper_html: { class: "mb-1" },
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control", rows: 12 } %>
        <p class="text-body-secondary small">
          Available Tags: {{requestor_name}} | {{date}} | {{application_url}} | {{all_locations}}
        </p>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="status_change_email_settings" role="tabpanel" aria-labelledby="status-email-tab">
    <h4 class="h5 mb-3">Status Change Email</h4>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.input :email_status_change_subject,
                    label: "Subject",
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control" } %>
      </div>
      <div class="col-12">
        <%= f.input :email_status_change_body,
                    as: :text,
                    label: "Body",
                    wrapper_html: { class: "mb-1" },
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control", rows: 12 } %>
        <p class="text-body-secondary small">
          Available Tags: {{request_url}} | {{requestor_name}} | {{date}} | {{status}} | {{admin_user_email}} | {{admin_user_name}} | {{course_name}} | {{location_name}} | {{location_email}} | {{all_locations}}
        </p>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="expiry_notice_email_settings" role="tabpanel" aria-labelledby="expiry-email-tab">
    <h4 class="h5 mb-3">Expiry Notice Email</h4>
    <div class="row g-3">
      <div class="col-12 col-lg-6">
        <%= f.input :email_request_expiry_notice_subject,
                    label: "Subject",
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control" } %>
      </div>
      <div class="col-12">
        <%= f.input :email_request_expiry_notice_body,
                    as: :text,
                    label: "Body",
                    wrapper_html: { class: "mb-1" },
                    label_html: { class: "form-label" },
                    input_html: { class: "form-control", rows: 12 } %>
        <p class="text-body-secondary small">
          Available Tags: {{request_url}} | {{rollover_url}} | {{requestor_name}} | {{date}} | {{status}} | {{course_name}} | {{location_name}} | {{location_email}} | {{all_locations}}
        </p>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="helpful_tags_settings" role="tabpanel" aria-labelledby="helpful-tags-tab">
    <h4 class="h5 mb-3">Useful Tags For Email Text</h4>
    <p class="text-body-secondary">These tags will be processed and replaced with the actual value before the email is sent.</p>
    <ul class="list-group list-group-flush mb-3">
      <li class="list-group-item"><strong>{{requestor_name}}</strong> &mdash; Name of the requestor user</li>
      <li class="list-group-item"><strong>{{date}}</strong> &mdash; Today's date in Aug&nbsp;1, 2014</li>
      <li class="list-group-item"><strong>{{date-short}}</strong> &mdash; Today's date in 08-01-2014</li>
      <li class="list-group-item"><strong>{{status}}</strong> &mdash; Status of the request</li>
      <li class="list-group-item"><strong>{{current_user_email}}</strong> &mdash; Logged in user's email address</li>
      <li class="list-group-item"><strong>{{current_user_name}}</strong> &mdash; Logged in user's full name</li>
      <li class="list-group-item"><strong>{{course_name}}</strong> &mdash; The full name of the course</li>
      <li class="list-group-item"><strong>{{location_name}}</strong> &mdash; Name of pickup location of the request</li>
      <li class="list-group-item"><strong>{{all_locations}}</strong> &mdash; List of pickup locations (Scott, Bronfman, ...)</li>
    </ul>
    <div class="border-top pt-3">
      <ul class="list-group list-group-flush">
        <li class="list-group-item">
          <strong>{{application_url}}</strong> &mdash; Link to <%= Setting.app_name %> application. &mdash; <%= root_url %>
        </li>
        <li class="list-group-item">
          <strong>{{request_url}}</strong> &mdash; Direct link to request details. &mdash; <%= requests_url %>/:id
        </li>
        <li class="list-group-item">
          <strong>{{rollover_url}}</strong> &mdash; Direct link to request rollover page. &mdash; <%= rollover_confirm_request_url(1) %>
        </li>
      </ul>
    </div>
  </div>
</div>
