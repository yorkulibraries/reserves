<% title "Update Email Settings" %>

<div class="container py-2">
  <div class="row">
    <div class="col-lg-9 col-xl-8">

      <%= simple_form_for Setting.new, url: settings_path, method: :patch do |f| %>

        <div class="card-header bg-white border-0 pb-0">
          <p class="text-muted mb-0">Set up the email server settings used to send notifications from the application.</p>
        </div>
        <div class="card-body">
          <section class="mb-4 bg-light p-3">
            <h2 class="h6 text-uppercase text-primary mb-3">Email Settings</h2>
            <%= render "email_fields", f: f %>
          </section>
        </div>
        <div class="card-footer bg-white border-0 pt-0 d-flex justify-content-between align-items-center">
          <input type="hidden" name="return_to" value="email"/>  
          <%= f.submit "Save Settings", class: "btn btn-primary" %>
        </div>
        
      <% end %>
    </div>
  </div>
</div>