<% title "Course Faculties" %>

<div class="container py-4">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <p class="text-muted mb-0">Maintain faculty codes used across course management.</p>
    </div>
    <%= link_to "New Course Faculty", new_settings_faculty_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Code</th>
              <th scope="col">Name</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @faculties.any? %>
              <% @faculties.each do |faculty| %>
                <tr>
                  <td class="fw-semibold text-uppercase"><%= faculty.code %></td>
                  <td><%= faculty.name.presence || content_tag(:span, "Not provided", class: "text-muted") %></td>
                  <td class="text-end">
                    <%= link_to "Make Changes", edit_settings_faculty_path(faculty), class: "btn btn-outline-success btn-sm" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="3" class="text-center text-muted py-4">
                  No course faculties found yet.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
