<h2>Open Requests</h2>

<div class="list-group">
  <% @acquisition_requests.group_by(&:location).each do | location, requests | %>
    <div class="list-group-item acquisition-location-heading">
      <h4 class="list-group-item-heading mb-0"><%= location == nil ? "Unassigned Location" : location.name %></h4>
    </div>

    <% requests.each do |r| %>
      <a class="list-group-item" href="<%= acquisition_request_path(r) %>">
        <span class="badge small">By <%= r.requested_by.name rescue nil %></span>
        <h5 class="list-group-item-heading"><%= r.item.title rescue nil%></h5>
        <p class="list-group-item-text">
          <span class="small strong">Request ID: <%= r.item.request_id rescue nil %></span>
          <span class="weak">Requested on <%= r.created_at.strftime("%b %e, %Y") %></span>
        </p>
      </a>
    <% end %>
  <% end %>


</div>
