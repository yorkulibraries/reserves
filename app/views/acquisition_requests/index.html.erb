<% title "Acquisition Lists" %>

<div class="acquisition_requests">

  <div role="tabpanel">

  <!-- Nav tabs -->
  <ul class="nav nav-pills mb-3" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="open-tab" data-bs-toggle="pill" data-bs-target="#open" type="button" role="tab" aria-controls="open" aria-selected="true">
        Open
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="acquired-tab" data-bs-toggle="pill" data-bs-target="#acquired" type="button" role="tab" aria-controls="acquired" aria-selected="false">
        Acquired
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="cancelled-tab" data-bs-toggle="pill" data-bs-target="#cancelled" type="button" role="tab" aria-controls="cancelled" aria-selected="false">
        Cancelled
      </button>
    </li>
  </ul>

  <!-- Tab panes -->
  <div class="tab-content">
    <div role="tabpanel" class="tab-pane fade show active" id="open" aria-labelledby="open-tab">
      <%= render "open_requests" %>
    </div>
    <div role="tabpanel" class="tab-pane fade" id="acquired" aria-labelledby="acquired-tab">
      <%= render "acquired_requests" %>
    </div>
    <div role="tabpanel" class="tab-pane fade" id="cancelled" aria-labelledby="cancelled-tab">
      <%= render "cancelled_requests" %>
    </div>
  </div>

</div>
</div>
